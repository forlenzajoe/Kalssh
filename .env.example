# =============================================================================
# Kalshi Weather Scanner — environment configuration
# Copy this file to ".env" and fill in values. The .env file is git-ignored.
# The system runs fully in MOCK mode with NO keys set (see config.yaml).
# =============================================================================

# --- Kalshi API ---------------------------------------------------------------
# Kalshi uses RSA-key API authentication (API key id + private key PEM file).
# Leave blank to force mock mode regardless of config.yaml.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Environment: "demo" (paper) or "prod". Defaults to demo.
KALSHI_ENV=demo
# Base URL override (optional). Defaults are derived from KALSHI_ENV.
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# --- NOAA / NWS ---------------------------------------------------------------
# The NWS api (api.weather.gov) requires no key but asks for a descriptive
# User-Agent that includes contact info. Set yours here.
NWS_USER_AGENT=kalshi-weather-scanner (forlenza.joe@gmail.com)

# Optional NOAA Climate Data Online token (for historical/archive endpoints).
# Get one free at https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
